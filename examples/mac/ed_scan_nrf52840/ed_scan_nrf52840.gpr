with "config/ed_scan_nrf52840_config.gpr";
with "runtime_build.gpr";
with "ravenscar_build.gpr";
project Ed_Scan_Nrf52840 is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Ed_Scan_Nrf52840_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("ed_scan_nrf52840.adb");

   for Target use Runtime_Build'Target;
   for Runtime ("Ada") use Runtime_Build'Runtime ("Ada");

   package Compiler is
      for Default_Switches ("Ada") use Ed_Scan_Nrf52840_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   package Linker is
      for Switches ("Ada") use
        ("-Wl,--gc-sections",
         "-Wl,-Map=ed_scan_nrf52840.map",
         "-Wl,--print-memory-usage");
   end Linker;

end Ed_Scan_Nrf52840;
